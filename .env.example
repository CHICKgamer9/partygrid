# PartyGrid local defaults — copy to `.env` then run migrations.
# SQLite file is created next to this path (Prisma resolves it from prisma/).

# --- Database ---
# Local clone-and-run (SQLite):
DATABASE_URL="file:./dev.db"
#
# Production / Vercel: swap Prisma `provider` to "postgresql" and use e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/partygrid?sslmode=require"

# --- Auth.js / NextAuth ---
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
#
# App URL (Auth.js reads AUTH_URL; NEXTAUTH_URL kept for older docs)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (optional) ---
# Create an OAuth client in Google Cloud Console.
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
# Leave unset to hide "Continue with Google".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Discord OAuth (optional) ---
# Discord Developer Portal → OAuth2.
# Redirects:
#   {AUTH_URL}/api/auth/callback/discord   (sign-in via Auth.js)
#   {AUTH_URL}/api/discord/callback        (link account while signed in)
# Leave unset: connect UI stays visible but shows a configure-me state;
# users can still claim a Discord tag as unverified.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# --- Steam (optional) ---
# OpenID connect works without a key (SteamID is verified).
# STEAM_API_KEY enables persona name + avatar lookup and URL claim verification.
# Get a key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""
# Public origin used for OpenID realm/return (defaults to AUTH_URL / NEXTAUTH_URL)
STEAM_REALM="http://localhost:3000"
